        {
            "name": "realtime_pose_v1 | smoke tests",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
