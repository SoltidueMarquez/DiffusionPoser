                "--data_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz_tasks",
                "--data_split", "test",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--task_mode", "realtime_pose_reconstruction",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--cuda", "true",
                "--batch_size", "1",
                "--seq_len", "61",
                "--input_feats", "206",
                "--max_seq_len", "61",
                "--use_ema", "true",
                "--num_workers", "0"
            ]
        },
        {
            "name": "realtime_pose_v1 | 6 evaluate stream output",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "eval.evaluate_realtime_pose",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
