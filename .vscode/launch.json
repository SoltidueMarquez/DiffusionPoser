{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "realtime_pose_v1 | 1 convert AMASS source",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "data_converter.amass_to_realtime_pose",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--amass_dir", "${workspaceFolder}/dataset/AMASS",
                "--smpl_model_dir", "${workspaceFolder}/dataset/body_models",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz",
                "--target_fps", "60",
                "--batch_size", "256",
                "--mirror",
                "--skip_existing"
            ]
        },
        {
            "name": "realtime_pose_v1 | 2 compute normalizer",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "data_loaders.compute_realtime_pose_normalizer",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--source_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz",
                "--output_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--split", "train",
                "--overwrite"
            ]
        },
        {
            "name": "realtime_pose_v1 | 3 generate full-tracker tasks",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "data_loaders.generate_realtime_pose_tasks",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--source_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz_tasks",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--splits", "train", "test",
                "--seq_len", "61",
                "--samples_per_file", "4",
                "--mask_policy", "full",
                "--overwrite"
            ]
        },
        {
            "name": "realtime_pose_v1 | 4 train",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "train.train_diffusionposer",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--save_dir", "${workspaceFolder}/runs/realtime_pose_v1_train",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--task_mode", "realtime_pose_reconstruction",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--cuda", "true",
                "--batch_size", "256",
                "--seq_len", "61",
                "--input_feats", "206",
                "--max_seq_len", "61",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0",
                "--tracker_mask_policy", "dynamic_categories",
                "--tracker_mask_seed", "10",
                "--tracker_mask_fill", "zero",
                "--tracker_mask_categories", "all",
                "--tracker_pos_noise_std", "0.005",
                "--tracker_rot_noise_std", "0.01",
                "--non_hip_tracker_dropout_prob", "0.1",
                "--history_pose_noise_std", "0.01",
                "--history_yaw_noise_std", "0.01",
                "--root_yaw_ref_noise_std", "0.01",
                "--overwrite"
            ]
        },
        {
            "name": "realtime_pose_v1 | 4b resume latest",
            "type": "debugpy",
