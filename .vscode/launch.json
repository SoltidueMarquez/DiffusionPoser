{
    // 使用 VS Code 当前选择的 Python 解释器；建议选择 Conda 环境 DiffusionPoser。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "转换数据：AMASS 转 X277 并可视化",
            "type": "debugpy",
            "request": "launch",
            "module": "data_converter.amass_to_x277",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "args": [
                "--amass_dir", "${workspaceFolder}/dataset/AMASS",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_x277_60hz",
                "--smpl_model_dir", "${workspaceFolder}/dataset/body_models",
                "--mirror",
                "--visualize_num", "5",
                "--visualize_dir", "${workspaceFolder}/dataset/AMASS_x277_60hz/visualizations",
                "--visualize_fps", "60",
                "--skip_existing"
            ]
        },
        {
            "name": "生成数据：按 train/test split 生成 X277 缺失任务",
            "type": "debugpy",
            "request": "launch",
            "module": "data_loaders.generate_x277_missing_tasks",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "args": [
                "--source_dir", "${workspaceFolder}/dataset/AMASS_x277_60hz",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_x277_60hz_missing_tasks",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--splits", "train", // 如需同时生成测试集，可在这里追加 "test"。
                "--seq_len", "60",
                "--samples_per_file", "2",
                "--seed", "10",
                "--overwrite"
            ]
        },
        {
            "name": "统计归一化：按 train.txt 计算 X277 mean/std",
            "type": "debugpy",
            "request": "launch",
            "module": "data_loaders.compute_x277_normalizer",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "args": [
                // X277 源数据目录：统计 raw x: [T, 277]，不是统计 missing_tasks。
                "--source_dir", "${workspaceFolder}/dataset/AMASS_x277_60hz",
                // meta 输出目录：保存 mean.pt、std.pt 和 normalizer_meta.json。
                "--output_dir", "${workspaceFolder}/dataset/meta_AMASS_x277_60hz",
                // split 目录：默认使用 train.txt，避免 test 信息泄漏。
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--split", "train",
                "--overwrite"
            ]
        },
        {
            "name": "训练 DiffusionPoser X277 fix-only",
            "type": "debugpy",
            "request": "launch",
            "module": "train.train_diffusionposer",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "args": [
                // 输出目录：保存训练参数、日志和 checkpoint。
                "--save_dir", "${workspaceFolder}/save/diffusionposer_x277",
                // 缺失任务数据目录：训练样本已经包含 x、valid_frame_mask、sensor_missing_labels、inpaint_mask。
                "--data_dir", "${workspaceFolder}/dataset/AMASS_x277_60hz_missing_tasks",
                // 使用 train split 训练。
                "--data_split", "train",
                // meta 目录：normalize_input 读取 mean.pt/std.pt；weighted_loss 读取 feature_w.pt。
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_x277_60hz",
                // 标准化 X277 原始 277 维；6 维缺失标签会映射为 -1/+1，padding 仍为 0。
                "--normalize_input", "true",
                // 使用 GPU 训练。
                "--cuda", "true",
                // batch size：StableMotion 风格常用 256；显存不足时可降低。
                "--batch_size", "256",
                // 训练窗口长度：必须匹配缺失任务 manifest 中的 seq_len。
                "--seq_len", "60",
                // 模型输入通道数，固定为 X277 + 6 维缺失标签。
                "--input_feats", "283",
                // DiT Transformer block 数量。
                "--layers", "8",
                // 多头注意力 head 数。
                "--heads", "8",
                // Transformer 隐层宽度。
                "--latent_dim", "512",
                // 扩散训练步数 T；与 StableMotion 默认保持一致。
                "--diffusion_steps", "50",
                // 噪声日程：cosine 通常比 linear 更适合少步数扩散。
                "--noise_schedule", "cosine",
                // 1 表示模型预测 x0；0 表示预测 epsilon。
                "--predict_xstart", "1",
                // 使用 L1 masked reconstruction loss。
                "--l1_loss",
                // 保存 EMA 权重，采样/推理时通常更平滑。
                "--model_ema",
                // 梯度范数裁剪到 1.0。
                "--gradient_clip",
                // 学习率；这里对齐 StableMotion-FSQ 风格训练配置。
                "--lr", "5e-5",
                // 总训练 step。
                "--num_steps", "2000000",
                // 每多少 step 保存一次 model/opt/ema。
                "--save_interval", "2000",
                // 每多少 step 打印/写入一次日志。
                "--log_interval", "1000",
                // 最多保留最近 3 组 checkpoint，避免 save_dir 占满磁盘。
                "--checkpoint_max_keep", "3",
                // 写 TensorBoard 日志到 save_dir。
                "--train_platform_type", "TensorboardPlatform",
                // Windows 下先用 0；需要提升加载速度时再尝试 2/4。
                "--num_workers", "2"
            ]
        },
        {
            "name": "恢复训练 DiffusionPoser X277 fix-only",
            "type": "debugpy",
            "request": "launch",
            "module": "train.train_diffusionposer",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "args": [
                // 恢复训练仍写回同一个实验目录。
                "--save_dir", "${workspaceFolder}/save/diffusionposer_x277",
                // 数据目录必须和原训练保持一致。
                "--data_dir", "${workspaceFolder}/dataset/AMASS_x277_60hz_missing_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_x277_60hz",
                "--normalize_input", "true",
                // 指向要恢复的 model checkpoint；训练 loop 会自动找同 step 的 opt/ema。
                "--resume_checkpoint", "${workspaceFolder}/save/diffusionposer_x277/model000000000.pt",
                // 允许写入已有 save_dir。
                "--overwrite",
                "--cuda", "true",
                "--batch_size", "64",
                "--seq_len", "60",
                "--input_feats", "283",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--l1_loss",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0"
            ]
        }
    ]
}
