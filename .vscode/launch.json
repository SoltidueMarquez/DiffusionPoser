                "--input_feats", "283",
                "--visualize_num", "5",
                "--visualize_fps", "60",
                "--x277_fps", "60",
                "--use_ema", "true",
                "--num_workers", "0"
            ]
        }
    ],
    "inputs": [
        {
            "id": "current277ModelPath",
            "type": "promptString",
            "description": "current277 checkpoint path",
            "default": "${workspaceFolder}/save/diffusionposer_current277/model000002000.pt"
        },
        {
            "id": "legacyModelPath",
            "type": "promptString",
            "description": "legacy fix_tracker checkpoint path",
            "default": "${workspaceFolder}/save/diffusionposer_x277/model000012000.pt"
        }
    ]
