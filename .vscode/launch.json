{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "current277 | 1 转换 AMASS -> current277",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "data_converter.amass_to_x277",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--amass_dir", "${workspaceFolder}/dataset/AMASS",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz",
                "--smpl_model_dir", "${workspaceFolder}/dataset/body_models",
                "--target_fps", "60",
                "--batch_size", "256",
                "--mirror",
                "--visualize_num", "5",
                "--visualize_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz/visualizations",
                "--visualize_fps", "60",
                "--skip_existing"
            ]
        },
        {
            "name": "current277 | 2 统计 normalizer",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "data_loaders.compute_x277_normalizer",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--source_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz",
                "--output_dir", "${workspaceFolder}/dataset/meta_AMASS_current277_60hz",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--split", "train",
                "--overwrite"
            ]
        },
        {
            "name": "current277 | 3 生成 full reconstruction 任务",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "data_loaders.generate_x277_missing_tasks",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--source_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz_missing_tasks",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--splits", "train", "test",
                "--task_mode", "full_reconstruction_current",
                "--seq_len", "11",
                "--samples_per_file", "4",
                "--num_intervals", "1",
                "--min_missing_sensors", "1",
                "--max_missing_sensors", "4",
                "--min_observed_sensors", "2",
                "--all_sensor_dropout_prob", "0.10",
                "--seed", "10",
                "--overwrite"
            ]
        },
        {
            "name": "current277 | 4 训练 full reconstruction",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "train.train_diffusionposer",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--save_dir", "${workspaceFolder}/save/diffusionposer_current277",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz_missing_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_current277_60hz",
                "--task_mode", "full_reconstruction_current",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--cuda", "true",
                "--batch_size", "256",
                "--seq_len", "11",
                "--input_feats", "283",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--l1_loss",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0"
            ]
        },
        {
            "name": "current277 | 4b 恢复训练 latest",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "train.train_diffusionposer",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--save_dir", "${workspaceFolder}/save/diffusionposer_current277",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz_missing_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_current277_60hz",
                "--task_mode", "full_reconstruction_current",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--resume_checkpoint", "latest",
                "--overwrite",
                "--cuda", "true",
                "--batch_size", "256",
                "--seq_len", "11",
                "--input_feats", "283",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--l1_loss",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0"
            ]
        },
        {
            "name": "current277 | 5 离线流式重建 test",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "sample.reconstruct_stream",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--model_path", "${input:current277ModelPath}",
                "--output_dir", "${workspaceFolder}/output/current277_stream",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz_missing_tasks",
                "--data_split", "test",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_current277_60hz",
                "--task_mode", "full_reconstruction_current",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--cuda", "true",
                "--batch_size", "1",
                "--seq_len", "11",
                "--input_feats", "283",
                "--visualize_num", "0",
                "--use_ema", "true",
                "--num_workers", "0"
            ]
        },
        {
            "name": "current277 | 6 评估流式输出",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "eval.evaluate_current277",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--input_dir", "${workspaceFolder}/output/current277_stream",
                "--output_json", "${workspaceFolder}/output/current277_stream/current277_eval_summary.json"
            ]
        },
        {
            "name": "current277 | 测试 unittest",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "unittest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "tests.test_x277_data",
                "tests.test_current277_schema",
                "tests.test_fix_test",
                "tests.test_resume_checkpoint"
            ]
        },
        {
            "name": "legacy | fix_tracker 测试入口",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "sample.fix_test",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [
                "--model_path", "${input:legacyModelPath}",
                "--output_dir", "${workspaceFolder}/output/legacy_fix_tracker",
