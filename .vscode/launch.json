                "--data_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--task_mode", "realtime_pose_reconstruction",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--resume_checkpoint", "latest",
                "--overwrite",
                "--cuda", "true",
                "--batch_size", "256",
                "--seq_len", "61",
                "--input_feats", "206",
                "--max_seq_len", "61",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0",
                "--tracker_mask_policy", "dynamic_categories",
                "--tracker_mask_seed", "10",
                "--tracker_mask_fill", "zero",
                "--tracker_mask_categories", "all",
                "--tracker_pos_noise_std", "0.005",
                "--tracker_rot_noise_std", "0.01",
                "--non_hip_tracker_dropout_prob", "0.1",
                "--history_pose_noise_std", "0.01",
                "--history_yaw_noise_std", "0.01",
                "--root_yaw_ref_noise_std", "0.01"
            ]
        },
        {
            "name": "realtime_pose_v1 | 5 reconstruct stream test",
            "type": "debugpy",
            "request": "launch",
            "python": "C:/Users/Administrator/.conda/envs/diffusionposer5070/python.exe",
            "module": "sample.reconstruct_stream",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
