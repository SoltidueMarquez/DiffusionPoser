    "inputs": [
        {
            "id": "realtimePoseModelPath",
            "type": "promptString",
            "description": "realtime_pose_v1 checkpoint path",
            "default": "${workspaceFolder}/runs/realtime_pose_v1_train/model000002000.pt"
        }
