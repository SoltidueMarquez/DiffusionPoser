{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "current277: 1 convert AMASS",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "data_converter.amass_to_x277",
                "--amass_dir", "${workspaceFolder}/dataset/AMASS",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz",
                "--smpl_model_dir", "${workspaceFolder}/dataset/body_models",
                "--target_fps", "60",
                "--batch_size", "256",
                "--mirror",
                "--visualize_num", "5",
                "--visualize_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz/visualizations",
                "--visualize_fps", "60",
                "--skip_existing"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "current277: 2 compute normalizer",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "data_loaders.compute_x277_normalizer",
                "--source_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz",
                "--output_dir", "${workspaceFolder}/dataset/meta_AMASS_current277_60hz",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--split", "train",
                "--overwrite"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "current277: 3 generate full reconstruction tasks",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "data_loaders.generate_x277_missing_tasks",
                "--source_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz_missing_tasks",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--splits", "train", "test",
                "--task_mode", "full_reconstruction_current",
                "--seq_len", "11",
                "--samples_per_file", "4",
                "--num_intervals", "1",
                "--min_missing_sensors", "1",
                "--max_missing_sensors", "4",
                "--min_observed_sensors", "2",
                "--all_sensor_dropout_prob", "0.10",
                "--seed", "10",
                "--overwrite"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "current277: 4 train",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "train.train_diffusionposer",
                "--save_dir", "${workspaceFolder}/save/diffusionposer_current277",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz_missing_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_current277_60hz",
                "--task_mode", "full_reconstruction_current",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--cuda", "true",
                "--batch_size", "256",
                "--seq_len", "11",
                "--input_feats", "283",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--l1_loss",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "current277: 4b resume latest",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "train.train_diffusionposer",
                "--save_dir", "${workspaceFolder}/save/diffusionposer_current277",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz_missing_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_current277_60hz",
                "--task_mode", "full_reconstruction_current",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--resume_checkpoint", "latest",
                "--overwrite",
                "--cuda", "true",
                "--batch_size", "256",
                "--seq_len", "11",
                "--input_feats", "283",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--l1_loss",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "current277: 5 stream reconstruct",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "sample.reconstruct_stream",
                "--model_path", "${input:current277ModelPath}",
                "--output_dir", "${workspaceFolder}/output/current277_stream",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_current277_60hz_missing_tasks",
                "--data_split", "test",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_current277_60hz",
                "--task_mode", "full_reconstruction_current",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--cuda", "true",
                "--batch_size", "1",
                "--seq_len", "11",
                "--input_feats", "283",
                "--visualize_num", "0",
                "--use_ema", "true",
                "--num_workers", "0"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "current277: 6 evaluate stream outputs",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "eval.evaluate_current277",
                "--input_dir", "${workspaceFolder}/output/current277_stream",
                "--output_json", "${workspaceFolder}/output/current277_stream/current277_eval_summary.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "current277: tests",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "unittest",
                "tests.test_x277_data",
                "tests.test_current277_schema",
                "tests.test_fix_test",
                "tests.test_resume_checkpoint"
            ],
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "current277ModelPath",
            "type": "promptString",
            "description": "current277 checkpoint path",
            "default": "${workspaceFolder}/save/diffusionposer_current277/model000002000.pt"
        }
    ]
}
