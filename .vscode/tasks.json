{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "realtime_pose_v1: 1 convert AMASS source",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "data_converter.amass_to_realtime_pose",
                "--amass_dir", "${workspaceFolder}/dataset/AMASS",
                "--smpl_model_dir", "${workspaceFolder}/dataset/body_models",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz",
                "--target_fps", "60",
                "--batch_size", "256",
                "--mirror",
                "--skip_existing"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: 2 compute normalizer",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "data_loaders.compute_realtime_pose_normalizer",
                "--source_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz",
                "--output_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--split", "train",
                "--overwrite"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: 3 generate full-tracker tasks",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "data_loaders.generate_realtime_pose_tasks",
                "--source_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz",
                "--output_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz_tasks",
                "--split_dir", "${workspaceFolder}/data_loaders/splits",
                "--splits", "train", "test",
                "--seq_len", "61",
                "--samples_per_file", "4",
                "--mask_policy", "full",
                "--overwrite"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: 4 train",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "train.train_diffusionposer",
                "--save_dir", "${workspaceFolder}/runs/realtime_pose_v1_train",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--task_mode", "realtime_pose_reconstruction",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--cuda", "true",
                "--batch_size", "256",
                "--seq_len", "61",
                "--input_feats", "206",
                "--max_seq_len", "61",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0",
                "--tracker_mask_policy", "dynamic_categories",
                "--tracker_mask_seed", "10",
                "--tracker_mask_fill", "zero",
                "--tracker_mask_categories", "all",
                "--tracker_pos_noise_std", "0.005",
                "--tracker_rot_noise_std", "0.01",
                "--non_hip_tracker_dropout_prob", "0.1",
                "--history_pose_noise_std", "0.01",
                "--history_yaw_noise_std", "0.01",
                "--root_yaw_ref_noise_std", "0.01",
                "--overwrite"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: 4b resume latest",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "train.train_diffusionposer",
                "--save_dir", "${workspaceFolder}/runs/realtime_pose_v1_train",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz_tasks",
                "--data_split", "train",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--task_mode", "realtime_pose_reconstruction",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--resume_checkpoint", "latest",
                "--overwrite",
                "--cuda", "true",
                "--batch_size", "256",
                "--seq_len", "61",
                "--input_feats", "206",
                "--max_seq_len", "61",
                "--layers", "8",
                "--heads", "8",
                "--latent_dim", "512",
                "--diffusion_steps", "50",
                "--noise_schedule", "cosine",
                "--predict_xstart", "1",
                "--model_ema",
                "--gradient_clip",
                "--lr", "5e-5",
                "--num_steps", "2000000",
                "--save_interval", "2000",
                "--log_interval", "1000",
                "--checkpoint_max_keep", "3",
                "--train_platform_type", "TensorboardPlatform",
                "--num_workers", "0",
                "--tracker_mask_policy", "dynamic_categories",
                "--tracker_mask_seed", "10",
                "--tracker_mask_fill", "zero",
                "--tracker_mask_categories", "all",
                "--tracker_pos_noise_std", "0.005",
                "--tracker_rot_noise_std", "0.01",
                "--non_hip_tracker_dropout_prob", "0.1",
                "--history_pose_noise_std", "0.01",
                "--history_yaw_noise_std", "0.01",
                "--root_yaw_ref_noise_std", "0.01"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: 5 reconstruct stream test",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "sample.reconstruct_stream",
                "--model_path", "${input:realtimePoseModelPath}",
                "--output_dir", "${workspaceFolder}/output/realtime_pose_v1_stream",
                "--data_dir", "${workspaceFolder}/dataset/AMASS_realtime_pose_60hz_tasks",
                "--data_split", "test",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--task_mode", "realtime_pose_reconstruction",
                "--normalize_input", "true",
                "--preload_data", "false",
                "--cuda", "true",
                "--batch_size", "1",
                "--seq_len", "61",
                "--input_feats", "206",
                "--max_seq_len", "61",
                "--use_ema", "true",
                "--num_workers", "0"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: 6 evaluate stream output",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "eval.evaluate_realtime_pose",
                "--input_dir", "${workspaceFolder}/output/realtime_pose_v1_stream",
                "--output_json", "${workspaceFolder}/output/realtime_pose_v1_stream/realtime_pose_eval_summary.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: 7 export Unity runtime assets",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "export.write_unity_runtime_assets",
                "--output_dir", "${workspaceFolder}/../SIGGRAPH2024Unity/Assets/Projects/RealtimePose/Models/DiffusionPoser",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--normalize_input",
                "--strict_normalizer"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: 8 export Sentis denoiser",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "python", "-m", "export.export_sentis_denoiser",
                "--model_path", "${input:realtimePoseModelPath}",
                "--output_dir", "${workspaceFolder}/../SIGGRAPH2024Unity/Assets/Projects/RealtimePose/Models/DiffusionPoser",
                "--normalizer_dir", "${workspaceFolder}/dataset/meta_AMASS_realtime_pose_60hz",
                "--normalize_input", "true",
                "--strict_normalizer",
                "--use_ema", "true",
                "--device", "cpu"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "realtime_pose_v1: smoke tests",
            "type": "shell",
            "command": "conda",
            "args": [
                "run", "--no-capture-output", "-n", "diffusionposer5070",
                "pytest", "tests/smoke", "-q"
            ],
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1",
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "realtimePoseModelPath",
            "type": "promptString",
            "description": "realtime_pose_v1 checkpoint path",
            "default": "${workspaceFolder}/runs/realtime_pose_v1_train/model000002000.pt"
        }
    ]
}
